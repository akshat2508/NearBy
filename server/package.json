{
  "name": "nearby-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "src/server.js",
  "imports": {
    "#config/*": "./src/config/*",
    "#database/*": "./src/database/*",
    "#middleware/*": "./src/middleware/*",
    "#modules/*": "./src/modules/*",
    "#algorithms/*": "./src/algorithms/*",
    "#routes/*": "./src/routes/*",
    "#sockets/*": "./src/sockets/*",
    "#validators/*": "./src/validators/*",
    "#types/*": "./src/types/*",
    "#utils/*": "./src/utils/*"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev"
  },
  "dependencies": {
    "@clerk/backend": "^1.13.0",
    "@clerk/express": "^1.3.0",
    "@prisma/client": "^6.16.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "socket.io": "^4.8.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "prisma": "^6.16.2"
  }
}
